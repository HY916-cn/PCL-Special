<local:MyPageRight x:Class="PageOtherTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,25,25,10">
            <local:MyCard Title="百宝箱" Margin="0,0,0,15">
                <WrapPanel Margin="25,42,6,10">
                    <local:MyButton x:Name="BtnJrrp" Text="今日人品" Height="35" Margin="0,0,15,12" Width="140" />
                    <local:MyButton x:Name="BtnMemory" Text="内存优化" Height="35" Margin="0,0,15,12" Width="140" ToolTip="整理系统工作集与待机内存，需要管理员权限，可能短暂卡顿。" />
                    <local:MyButton x:Name="BtnClear" Text="清理缓存与日志" Height="35" Margin="0,0,15,12" Width="140" ToolTip="先预览游戏日志、崩溃报告和过期缓存，再确认清理。" />
                    <local:MyButton x:Name="BtnClick" Text="千万别点" Height="35" Margin="0,0,15,12" Width="140" ColorType="Red" />
                </WrapPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardCave" Title="回声洞" Margin="0,0,0,15">
                <Grid Margin="25,39,25,16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="LabCave" Margin="0,0,15,0" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyButton x:Name="BtnCave" Grid.Column="1" Text="换一句" MinWidth="90" Height="32" />
                </Grid>
            </local:MyCard>
            <local:MyCard Title="下载自定义文件" Margin="0,0,0,15">
                <Grid Margin="25,39,25,21">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Text="使用 PCL 多线程引擎下载 HTTP 或 HTTPS 文件，开始前选择保存位置。" TextWrapping="Wrap" Margin="0,0,0,15" />
                    <TextBlock Grid.Row="1" Text="下载地址" VerticalAlignment="Center" Margin="0,0,20,12" />
                    <local:MyTextBox x:Name="TextDownloadUrl" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" HintText="https://" />
                    <TextBlock Grid.Row="2" Text="文件名" VerticalAlignment="Center" Margin="0,0,20,12" />
                    <local:MyTextBox x:Name="TextDownloadName" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="3" Text="保存文件夹" VerticalAlignment="Center" Margin="0,0,20,12" />
                    <local:MyTextBox x:Name="TextDownloadFolder" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Margin="0,0,10,12" HintText="开始下载时选择保存位置" />
                    <local:MyButton x:Name="BtnDownloadSelect" Grid.Row="3" Grid.Column="2" Text="选择" Width="80" Height="28" Margin="0,0,0,12" />
                    <WrapPanel Grid.Row="4" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <local:MyButton x:Name="BtnDownloadStart" Text="开始下载" IsEnabled="False" MinWidth="135" Height="35" Margin="0,0,16,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnDownloadOpen" Text="打开文件夹" IsEnabled="False" MinWidth="135" Height="35" />
                    </WrapPanel>
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
